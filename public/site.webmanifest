{
  "name": "Jungle NFT Marketplace",
  "short_name": "Jungle",
  "id": "/",
  "description": "Marketplace demonstrativo de arte digital com experiência responsiva e compra simulada.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#160d08",
  "theme_color": "#160d08",
  "categories": ["shopping", "entertainment", "lifestyle"],
  "icons": [
    {
      "src": "/icons/jungle-app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/jungle-app-icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icons/jungle-app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/jungle-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Explorar NFTs",
      "short_name": "Explorar",
      "url": "/#catalogo",
      "icons": [{ "src": "/icons/jungle-app-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Abrir carrinho",
      "short_name": "Carrinho",
      "url": "/cart",
      "icons": [{ "src": "/icons/jungle-app-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
